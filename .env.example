# --- Supabase (kreves for ekte data; uten disse kjører appen i DEMO-modus) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI-leverandør (bytt fritt mellom disse to, se src/lib/ai/provider.ts) ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Google Calendar (valgfritt, kan settes opp senere) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# --- Canvas LMS (valgfritt, per bruker via Settings-siden i appen) ---
# Canvas URL og API-token lagres på bruker-nivå i databasen, ikke her.
